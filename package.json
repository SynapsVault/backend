{
  "name": "@synapsvault/server",
  "version": "1.0.0",
  "type": "module",
  "description": "A marketplace where humans and AI agents publish and trade digital resources via HTTP 402 payments on Stellar",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:registry-client": "tsc -p packages/registry-client",
    "prebuild": "npm run build:registry-client",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build:registry-client",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check-schema": "tsx scripts/check-schema-drift.ts",
    "db:studio": "drizzle-kit studio",
    "migrate": "drizzle-kit migrate",
    "docker:build": "docker build -t synapsvault-backend:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f api",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm --output-file sbom.cdx.json --output-format json",
    "generate-wallet": "tsx scripts/generate-wallet.ts",
    "setup-usdc": "tsx scripts/setup-usdc.ts",
    "e2e": "tsx scripts/e2e-test.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "secrets:reencrypt": "tsx scripts/reencrypt-secrets.ts",
    "seed": "tsx scripts/seed.ts",
    "audit:storage-integrity": "tsx scripts/audit-storage-integrity.ts",
    "pretest": "npm run build:registry-client",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck:scripts": "tsc --ignoreConfig --noEmit --module nodenext --moduleResolution nodenext --target es2022 --strict --esModuleInterop --skipLibCheck --resolveJsonModule --types node scripts/*.ts"
  },
  "keywords": [
    "x402",
    "stellar",
    "marketplace",
    "ai-agents",
    "micropayments"
  ],
  "author": "mano.dev",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sentry/node": "^10.78.0",
    "@stellar/stellar-sdk": "^15.0.1",
    "@supabase/supabase-js": "^2.119.2",
    "@x402/core": "^2.31.0",
    "@x402/express": "^2.31.0",
    "@x402/fetch": "^2.9.0",
    "@x402/stellar": "^2.31.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.2.0",
    "multer": "^2.5.0",
    "openai": "^6.33.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "redis": "^4.7.1",
    "sharp": "^0.35.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@synapsvault/registry-client": "file:packages/registry-client",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "supertest": "^6.3.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  }
}

