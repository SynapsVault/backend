# SynapsVault Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env.

PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://synapse:synapse@localhost:5432/synapsvault
# Maximum number of connections in the database pool.
DB_POOL_MAX=10
# Milliseconds an idle connection may remain in the pool before being closed.
DB_POOL_IDLE_TIMEOUT_MS=30000
# Milliseconds to wait for a new connection before failing.
DB_POOL_CONNECT_TIMEOUT_MS=5000
# Per-statement timeout in milliseconds (0 disables the timeout).
DB_STATEMENT_TIMEOUT_MS=30000

# Supabase (for file storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Stellar
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_CONTRACT_VAULT_REGISTRY=your_vault_registry_contract_id
STELLAR_CONTRACT_ACCESS_LEASE=your_access_lease_contract_id
STELLAR_CONTRACT_SUBSCRIPTION=your_subscription_contract_id
STELLAR_SECRET_KEY=your_backend_wallet_secret_key
STELLAR_USDC_CONTRACT=native

# Admin
ADMIN_API_KEY=change_me_to_a_secure_random_string_32_chars

# Metrics
# Bearer token required to access the /metrics endpoint. Leave empty to disable auth.
METRICS_TOKEN=

# Request signing
# When true, mutating API requests must carry a valid signature.
REQUIRE_REQUEST_SIGNATURE=false
# Maximum allowed clock skew (in milliseconds) between client and server timestamps.
SIGNATURE_MAX_SKEW_MS=300000

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Optional: Sentry error tracking
SENTRY_DSN=

# Optional: OpenTelemetry collector
OTLP_ENDPOINT=http://localhost:4318

# Optional: Webhook retry queue
WEBHOOK_SECRET=your_webhook_signing_secret

# Publisher rate limiting
# Max requests allowed per publisher within the rate-limit window.
PUBLISHER_RATE_LIMIT_MAX=100
# Rate-limit window in milliseconds (default: 60000 = 1 minute).
PUBLISHER_RATE_LIMIT_WINDOW_MS=60000

# Publisher webhooks
# Endpoint that receives publisher webhook deliveries, e.g. https://example.com/webhooks/publisher
PUBLISHER_WEBHOOK_URL=
# Secret used to sign publisher webhook payloads (HMAC).
PUBLISHER_WEBHOOK_SECRET=your_publisher_webhook_signing_secret
# Number of delivery attempts before a publisher webhook is marked failed.
PUBLISHER_WEBHOOK_MAX_RETRIES=5
# Delay in milliseconds between publisher webhook retry attempts.
PUBLISHER_WEBHOOK_RETRY_DELAY_MS=5000

# Publisher endpoints (for reference):
#   POST /api/publishers/:id/webhooks  — register/update a publisher webhook
#   GET  /api/publishers/:id/webhooks  — list configured publisher webhooks
#   POST /api/publishers/:id/rate-limit — view/update publisher rate-limit settings